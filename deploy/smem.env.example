# SPDX-License-Identifier: MIT
# smem configuration. Copy to /etc/smem/smem.env (mode 0600 if it holds a
# token or password); the units in deploy/systemd/ read it. Every line is
# commented out at its default -- uncomment only what you change.
# For the CLI, export the same variables in your shell.

# ---------------------------------------------------------- smem (API + CLI)

# Hosts running the three llama-servers, comma-separated (names or IPs).
#SMEM_NODES=127.0.0.1
# Separate hosts for the background ingest/dreaming worker, comma-separated.
# Empty = the worker shares SMEM_NODES. Only useful with different machines.
#SMEM_BG_NODES=
# Ports of the embedder, reranker and LLM on every node.
#SMEM_PORT_EMB=8080
#SMEM_PORT_RRK=8081
#SMEM_PORT_LLM=8082
# SQLite database (CLI and server; the server's --db flag overrides it).
# Default ~/.local/share/smem/smem.db; deploy/systemd/smem-api.service sets
# /var/lib/smem/smem.db. Its directory is created if missing.
#SMEM_DB=~/.local/share/smem/smem.db
# Require "Authorization: Bearer <token>" on every /v* route. Unset = no auth.
#SMEM_TOKEN=
# Background worker typing and linking memories when idle: 1 = on, 0 = off.
#SMEM_DREAMING=1
# Per-node telemetry in the console: "ssh" samples each node every 15 s over
# ssh (temperatures, memory, sm-emb/sm-rrk/sm-llm units). Unset = off.
#SMEM_NODE_PROBE=
# Password for that ssh (uses sshpass). Unset = ssh key auth (BatchMode).
#NODE_PW=
# JSON file another service writes to borrow nodes temporarily:
#   {"nodes": ["10.0.0.5"], "until": <epoch seconds>}
#SMEM_PAUSE_FILE=/run/smem/paused.json
# 1 = let POST /v3/documents {url} fetch private/LAN addresses.
#SMEM_ALLOW_PRIVATE_URLS=

# ------------------------------------- model servers (deploy/systemd/smem-*.service)

# llama.cpp server binary. The embedder needs build b11476 or newer.
#LLAMA_SERVER=/usr/local/bin/llama-server
# Address the model servers listen on. 0.0.0.0 to serve smem on another host.
#LLAMA_HOST=127.0.0.1
# CPU threads per model server (three run at once).
#LLAMA_THREADS=4
#SMEM_EMB_MODEL=/var/lib/smem/models/embeddinggemma-2-Q8_0.gguf
#SMEM_RRK_MODEL=/var/lib/smem/models/qwen3-reranker-0.6b-q8_0.gguf
#SMEM_LLM_MODEL=/var/lib/smem/models/gemma-4-E4B-it-Q4_K_M.gguf

# ------------------------------------------- MCP bridge (smem/connect/mcp_smem.py)
# Set in the MCP client's config, not here; listed for completeness.
#SMEM_URL=http://127.0.0.1:8900
#SMEM_CONTAINER=claude
#SMEM_TOKEN=          (same token as the server's)

# Intel VCA 2 reference scripts (deploy/vca2/) also read VCA_NODES, SMEM_UB,
# SMEM_CONTAINER and SMEM_PORT; see the top of deploy/vca2/services.sh.
